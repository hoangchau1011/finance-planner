generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// BETTER AUTH - USER
// ==========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Quan hệ Better Auth
  sessions Session[]
  accounts Account[]

  // Quan hệ Finance Planner
  transactions Transaction[]
  wishlist     WishlistItem[]
  budgets      MonthlyBudget[]
}

// ==========================================
// BETTER AUTH - SESSION
// ==========================================

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ==========================================
// BETTER AUTH - ACCOUNT
// ==========================================

model Account {
  id         String @id
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// ==========================================
// BETTER AUTH - VERIFICATION
// ==========================================

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ==========================================
// FINANCE PLANNER - ENUMS
// ==========================================

enum TransactionType {
  INCOME
  EXPENSE
}

enum Category {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  SHOPPING
  BILLS
  SALARY
  INVESTMENT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ==========================================
// FINANCE PLANNER - TRANSACTIONS
// ==========================================

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int
  description String
  category    Category
  date        DateTime
  createdAt   DateTime        @default(now())

  @@index([userId, date])
}

// ==========================================
// FINANCE PLANNER - WISHLIST
// ==========================================

model WishlistItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  cost        Int
  savedAmount Int      @default(0)
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ==========================================
// FINANCE PLANNER V1.0 - MONTHLY BUDGET
// ==========================================

model MonthlyBudget {
  id String @id @default(cuid())

  // Mỗi ngân sách thuộc một tài khoản.
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tháng quản lý theo định dạng YYYY-MM.
  // Ví dụ: 2026-11
  month String @db.VarChar(7)

  // Sử dụng Category hiện có.
  category Category

  // Hạn mức ngân sách, đơn vị VND.
  limitAmount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mỗi user chỉ có một ngân sách
  // cho mỗi danh mục trong một tháng.
  @@unique([userId, month, category])
  // Hỗ trợ truy vấn ngân sách theo tháng.
  @@index([userId, month])
}
