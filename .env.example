
# ==========================================
# FINANCE PLANNER V1.0
# ENVIRONMENT VARIABLES - EXAMPLE ONLY
# ==========================================

# Sao chép thành .env khi chạy local.
# Không commit .env hoặc .env.local.
# Chỉ dùng placeholder, không đặt secret thật tại đây.

# ==========================================
# 1. NEON POSTGRESQL
# ==========================================

# Pooled connection:
# Dùng để kết nối ứng dụng với Neon.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"

# Direct connection:
# Dùng bởi prisma.config.ts cho migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"

# ==========================================
# 2. BETTER AUTH
# ==========================================

# Thay bằng chuỗi ngẫu nhiên đủ mạnh.
# Không sử dụng chuỗi ví dụ làm secret thật.
BETTER_AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# Local:
BETTER_AUTH_URL="http://localhost:3000"

# Trên Vercel thay bằng:
# BETTER_AUTH_URL="https://YOUR-PRODUCTION-DOMAIN.vercel.app"

# ==========================================
# 3. GITHUB OAUTH
# ==========================================

# Lấy từ GitHub OAuth App.
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
