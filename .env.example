
# ==========================================
# FINANCE PLANNER - ENVIRONMENT VARIABLES
# ==========================================

# PostgreSQL Neon - Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"

# PostgreSQL Neon - Direct connection
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"

# ==========================================
# BETTER AUTH 1.7
# ==========================================

# Secret ngẫu nhiên, tối thiểu 32 ký tự
BETTER_AUTH_SECRET=""

# URL ứng dụng
BETTER_AUTH_URL="http://localhost:3000"

# ==========================================
# GITHUB OAUTH
# ==========================================

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ==========================================
# LEGACY FP2 LOCAL DEMO
# ==========================================

# Chỉ sử dụng trong fp2.
# Sau khi fp3 hoàn tất phải vô hiệu hóa.
FP1_LOCAL_PREVIEW="false"
