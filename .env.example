# Copy this file to .env. Do not commit .env.
# Neon pooled connection, used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"
# Neon direct connection, used by Prisma migrations:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"
# Preview ONLY on a local Next.js development server; no authentication until fp3.
FP1_LOCAL_PREVIEW="true"
# Added and populated during fp3 (never expose secrets with NEXT_PUBLIC_):
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
